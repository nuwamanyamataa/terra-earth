---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageBanner from '../../components/PageBanner.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import TalkPanel from '../../components/TalkPanel.astro';
import CTABand from '../../components/CTABand.astro';
import { getProjects } from '../../data/content';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((p) => ({ params: { slug: p.slug }, props: { project: p } }));
}
const { project } = Astro.props;
const { data } = project;
const { Content } = await project.render();
const related = (await getProjects())
  .filter((p) => p.slug !== project.slug && p.data.categories.some((c) => data.categories.includes(c)))
  .slice(0, 3);
const facts = [
  { label: 'Client', value: data.clientType },
  { label: 'Location', value: data.location },
  { label: 'Year', value: data.year },
  ...(data.duration ? [{ label: 'Duration', value: data.duration }] : []),
  ...(data.value ? [{ label: 'Value', value: data.value }] : []),
  ...data.facts,
];
const gallery = data.gallery.length ? data.gallery : data.image ? [{ src: data.image, alt: data.imageAlt ?? '' }] : [];
---
<BaseLayout title={`${data.title} | Terra Earth Engineering Projects`} description={data.summary} image={data.image} noindex={data.draft}>
  <PageBanner title={data.title} label={data.categories.join(' · ')} intro={data.summary} crumbs={[{ label: 'Projects', href: '/projects' }]} image={data.image} />

  <section class="section">
    <div class="container layout">
      <div>
        {data.draft && <p class="draft-note">Placeholder project — marked draft, so it does not appear on the live site.</p>}
        {gallery.length > 0 && (
          <div class:list={['gallery', { 'gallery--multi': gallery.length > 1 }]}>
            {gallery.map((g, i) => <figure class="photo"><img src={g.src} alt={g.alt} width="1200" height="900" loading={i === 0 ? 'eager' : 'lazy'} /></figure>)}
          </div>
        )}
        <div class="prose"><Content /></div>
      </div>
      <aside class="side">
        <div class="facts">
          <h2>Key facts</h2>
          <dl>
            {facts.map((f) => <div><dt>{f.label}</dt><dd>{f.value}</dd></div>)}
            <div><dt>Services</dt><dd><ul>{data.services.map((s) => <li>{s}</li>)}</ul></dd></div>
          </dl>
        </div>
        <TalkPanel />
      </aside>
    </div>
  </section>

  {related.length > 0 && (
    <section class="section section--alt">
      <div class="container">
        <div class="section-head"><span class="label">Related projects</span><h2>More work like this</h2></div>
        <div class="grid grid--3">
          {related.map((p) => <ProjectCard title={p.data.title} href={`/projects/${p.slug}`} image={p.data.image} imageAlt={p.data.imageAlt} location={p.data.location} clientType={p.data.clientType} year={p.data.year} categories={p.data.categories} draft={p.data.draft} />)}
        </div>
      </div>
    </section>
  )}

  <CTABand title="Have a similar project?" />
</BaseLayout>

<style>
  .layout { display: grid; gap: var(--space-12); }
  @media (min-width: 1100px) { .layout { grid-template-columns: 1fr 360px; gap: var(--space-16); } .side { position: sticky; top: 100px; align-self: start; } }
  .draft-note { background: #fdecea; color: var(--signal-error); font-weight: 600; padding: var(--space-3) var(--space-4); border-radius: var(--radius-sm); }
  .gallery { display: grid; gap: var(--space-3); margin-bottom: var(--space-8); }
  .gallery .photo { aspect-ratio: 16 / 9; }
  .gallery--multi { grid-template-columns: repeat(2, 1fr); }
  .gallery--multi .photo:first-child { grid-column: 1 / -1; }
  .prose { max-width: 70ch; font-size: 1.05rem; }
  .prose :global(h2) { font-size: 1.5rem; margin-top: var(--space-8); padding-top: var(--space-6); border-top: 1px solid var(--line); }
  .prose :global(h2:first-child) { margin-top: 0; padding-top: 0; border-top: 0; }
  .side { display: grid; gap: var(--space-6); }
  .facts { background: var(--green-soft); padding: var(--space-6); border-radius: var(--radius-md); border-top: 5px solid var(--terra-green); }
  .facts h2 { font-size: 1.2rem; }
  .facts dl { margin: 0; }
  .facts dl > div { padding: var(--space-3) 0; border-bottom: 1px solid #cfe5ca; }
  .facts dl > div:last-child { border-bottom: 0; }
  .facts dt { font-size: 0.72rem; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; color: var(--ink-muted); }
  .facts dd { margin: 2px 0 0; font-weight: 600; }
  .facts ul { margin: 0; padding-left: 1.1rem; font-weight: 500; }
</style>
