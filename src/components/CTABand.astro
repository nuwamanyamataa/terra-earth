---
import Icon from './Icon.astro';
import { company, whatsappLink } from '../data/site';
interface Props { title?: string; text?: string }
const {
  title = "Have a project in mind? Let's talk.",
  text = 'Tell us what you need. An engineer will get back to you within one working day.',
} = Astro.props;
---
<section class="cta">
  <div class="container cta__inner">
    <div>
      <h2>{title}</h2>
      <p>{text}</p>
    </div>
    <div class="btn-row">
      <a class="btn btn--dark" href={`tel:${company.phones[0].tel}`}><Icon name="phone" /> Call us</a>
      <a class="btn btn--dark" href={whatsappLink()} target="_blank" rel="noopener"><Icon name="chat" /> WhatsApp</a>
      <a class="btn btn--outline" href="/quote">Request a Quote <Icon name="arrow" /></a>
    </div>
  </div>
</section>

<style>
  .cta { background: var(--terra-green); color: var(--on-green); padding: var(--space-12) 0; }
  .cta__inner { display: grid; gap: var(--space-6); align-items: center; }
  @media (min-width: 960px) { .cta__inner { grid-template-columns: 1.2fr auto; gap: var(--space-12); } }
  .cta h2 { color: var(--on-green); margin-bottom: var(--space-2); }
  .cta p { margin: 0; font-weight: 500; }
  .cta .btn--outline { border-color: var(--terra-charcoal); }
</style>
