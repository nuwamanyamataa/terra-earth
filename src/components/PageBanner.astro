---
interface Crumb { label: string; href?: string }
interface Props { title: string; label?: string; intro?: string; crumbs?: Crumb[]; image?: string }
const { title, label, intro, crumbs = [], image } = Astro.props;
const all = [{ label: 'Home', href: '/' }, ...crumbs];
const schema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [...all, { label: title }].map((c, i) => ({
    '@type': 'ListItem', position: i + 1, name: c.label,
    ...(('href' in c && c.href) ? { item: new URL(c.href, Astro.site).href } : {}),
  })),
};
---
<section class:list={['banner', 'on-dark', { 'banner--image': image }]} style={image ? `--banner-img: url('${image}')` : undefined}>
  <div class="container banner__inner">
    <nav aria-label="Breadcrumb">
      <ol class="crumbs">
        {all.map((c) => <li><a href={c.href}>{c.label}</a></li>)}
        <li aria-current="page">{title}</li>
      </ol>
    </nav>
    {label && <span class="label">{label}</span>}
    <h1>{title}</h1>
    {intro && <p class="banner__intro">{intro}</p>}
  </div>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
</section>

<style>
  .banner { position: relative; background: var(--terra-charcoal); color: #fff; padding: var(--space-12) 0 var(--space-16); overflow: hidden; }
  .banner--image { background-image: linear-gradient(90deg, rgba(41,54,65,.94) 0%, rgba(41,54,65,.82) 55%, rgba(41,54,65,.6) 100%), var(--banner-img); background-size: cover; background-position: center; }
  .banner::after { content: ''; position: absolute; left: 0; right: 0; bottom: 0; height: 6px; background: var(--terra-green); }
  .banner__inner { position: relative; }
  .banner h1 { color: #fff; max-width: 820px; margin-bottom: var(--space-3); }
  .banner__intro { max-width: 680px; font-size: 1.125rem; color: #d5dce1; margin: 0; }
  .crumbs { display: flex; flex-wrap: wrap; gap: 6px; list-style: none; padding: 0; margin: 0 0 var(--space-6); font-size: 0.82rem; color: #b8c3ca; }
  .crumbs li + li::before { content: '/'; margin-right: 6px; color: var(--terra-green); }
  .crumbs a { color: #d5dce1; text-decoration: none; }
  .crumbs a:hover { color: var(--terra-green); text-decoration: underline; }
</style>
