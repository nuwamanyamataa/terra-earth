---
interface Props { name: string; role: string; discipline: string; initials: string; bio?: string; photo?: string }
const { name, role, discipline, initials, bio, photo } = Astro.props;
---
<article class="director reveal">
  <div class="director__photo">
    {photo ? <img src={photo} alt={`Portrait of ${name}`} loading="lazy" width="400" height="400" /> : (
      <div class="director__initials" role="img" aria-label={`Photo of ${name} coming soon`}>{initials}</div>
    )}
  </div>
  <div class="director__body">
    <h3>{name}</h3>
    <p class="director__role">{role}</p>
    <p class="director__disc">{discipline}</p>
    {bio && <p class="director__bio">{bio}</p>}
  </div>
</article>

<style>
  .director { display: grid; grid-template-columns: 96px 1fr; gap: var(--space-6); align-items: start; padding: var(--space-6); background: #fff; border: 1px solid var(--line); border-radius: var(--radius-md); height: 100%; }
  @media (min-width: 640px) { .director { grid-template-columns: 120px 1fr; } }
  .director__photo img, .director__initials { width: 100%; aspect-ratio: 1; border-radius: var(--radius-md); object-fit: cover; }
  .director__initials { display: grid; place-items: center; background: var(--terra-charcoal); color: var(--terra-green); font-size: 2rem; font-weight: 700; letter-spacing: 0.05em; border-bottom: 5px solid var(--terra-green); }
  .director h3 { margin-bottom: 4px; }
  .director__role { font-size: 0.75rem; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase; color: var(--green-text); margin-bottom: 4px; }
  .director__disc { font-weight: 600; margin-bottom: var(--space-3); }
  .director__bio { color: var(--ink-muted); font-size: 0.95rem; margin: 0; }
</style>
