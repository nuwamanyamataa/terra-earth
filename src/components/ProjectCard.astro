---
interface Props {
  title: string; href?: string; image?: string; imageAlt?: string;
  location?: string; clientType?: string; year?: string; categories: string[]; draft?: boolean;
}
const { title, href, image, imageAlt = '', location, clientType, year, categories, draft } = Astro.props;
const meta = [clientType, location, year].filter(Boolean).join(' · ');
---
<article class="pcard reveal" data-categories={categories.join('|')}>
  <div class="pcard__img">
    {image ? <img src={image} alt={imageAlt} loading="lazy" width="800" height="600" /> : <div class="placeholder">Photo: project site</div>}
    {draft && <span class="pcard__draft">Draft — hidden on live site</span>}
  </div>
  <div class="pcard__body">
    <div class="pcard__tags">{categories.map((c) => <span class="tag">{c}</span>)}</div>
    <h3>{href ? <a href={href}>{title}</a> : title}</h3>
    {meta && <p class="pcard__meta">{meta}</p>}
  </div>
</article>

<style>
  .pcard { position: relative; background: #fff; border: 1px solid var(--line); border-radius: var(--radius-md); overflow: hidden; height: 100%; display: flex; flex-direction: column; transition: box-shadow .2s; }
  .pcard:hover { box-shadow: 0 12px 30px rgba(41,54,65,.1); }
  .pcard:focus-within { outline: 3px solid var(--terra-green); outline-offset: 2px; }
  .pcard__img { position: relative; aspect-ratio: 4 / 3; background: var(--surface-alt); }
  .pcard__img img, .pcard__img .placeholder { width: 100%; height: 100%; object-fit: cover; border: 0; border-radius: 0; }
  .pcard__draft { position: absolute; top: 12px; left: 12px; background: var(--signal-error); color: #fff; font-size: 0.72rem; font-weight: 700; padding: 4px 10px; border-radius: var(--radius-sm); }
  .pcard__body { padding: var(--space-6); }
  .pcard__tags { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: var(--space-3); }
  .pcard h3 { margin-bottom: var(--space-2); }
  .pcard h3 a { color: var(--terra-charcoal); text-decoration: none; }
  .pcard h3 a::after { content: ''; position: absolute; inset: 0; }
  .pcard h3 a:focus-visible { outline: none; }
  .pcard__meta { font-size: 0.88rem; color: var(--ink-muted); margin: 0; }
  .pcard[hidden] { display: none; }
</style>
