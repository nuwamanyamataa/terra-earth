---
import Icon from './Icon.astro';
interface Props { items: { q: string; a: string }[] }
const { items } = Astro.props;
const schema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: items.map((i) => ({ '@type': 'Question', name: i.q, acceptedAnswer: { '@type': 'Answer', text: i.a } })),
};
---
<div class="faq">
  {items.map((item) => (
    <details class="faq__item">
      <summary>{item.q}<Icon name="chevron" /></summary>
      <p>{item.a}</p>
    </details>
  ))}
</div>
<script type="application/ld+json" set:html={JSON.stringify(schema)} />

<style>
  .faq { border-top: 1px solid var(--line); }
  .faq__item { border-bottom: 1px solid var(--line); }
  .faq summary { list-style: none; cursor: pointer; display: flex; justify-content: space-between; align-items: center; gap: var(--space-4); padding: var(--space-4) 0; font-weight: 600; color: var(--terra-charcoal); min-height: 44px; }
  .faq summary::-webkit-details-marker { display: none; }
  .faq summary :global(svg) { width: 20px; height: 20px; flex: none; color: var(--green-text); transition: transform .2s; }
  .faq details[open] summary :global(svg) { transform: rotate(180deg); }
  .faq details p { margin: 0 0 var(--space-4); color: var(--ink-muted); max-width: 70ch; }
</style>
